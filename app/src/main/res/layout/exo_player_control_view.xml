<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Badge LIVE, pojok kiri bawah -> gak nabrak tombol fullscreen -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_fullscreen_toggle"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_live_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Tombol play/pause doang di tengah, gak ada rewind/forward/prev/next/settings -->
    <ImageButton
        android:id="@id/exo_play"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_fullscreen_toggle"
        android:padding="16dp"
        android:tint="@color/text_primary"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="Play" />

    <ImageButton
        android:id="@id/exo_pause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_fullscreen_toggle"
        android:padding="16dp"
        android:tint="@color/text_primary"
        android:src="@android:drawable/ic_media_pause"
        android:contentDescription="Pause" />

</FrameLayout>
