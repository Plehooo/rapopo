<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:elevation="2dp"
    android:background="@drawable/bg_channel_selector">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="94dp">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="28dp"
            android:scaleType="fitCenter"
            android:contentDescription="Channel logo" />

        <TextView
            android:id="@+id/channelInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_star_outline"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Favorite" />
    </FrameLayout>

    <TextView
        android:id="@+id/channelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="14sp"
        android:lineSpacingExtra="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/channelLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/live_dot"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/channelGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/channelNowPlaying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_button_primary"
        android:text="▶ SEDANG DIPUTAR"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="9sp"
        android:letterSpacing="0.04"
        android:visibility="gone" />

</LinearLayout>
