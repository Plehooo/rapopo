<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp_10"
    android:layout_marginEnd="@dimen/dp_10"
    android:layout_marginBottom="@dimen/dp_10"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/dp_10"
    android:elevation="@dimen/dp_2"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_channel_selector">

    <FrameLayout
        android:layout_width="@dimen/dp_78"
        android:layout_height="@dimen/dp_78"
        android:background="@drawable/bg_music_thumbnail_frame"
        android:padding="@dimen/dp_2">

        <ImageView
            android:id="@+id/musicThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Sampul lagu" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_14"
        android:orientation="vertical">

        <TextView
            android:id="@+id/musicTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="@dimen/sp_14" />

        <TextView
            android:id="@+id/musicSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <TextView
        android:id="@+id/musicPlayIcon"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_6"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/game_accent_light"
        android:textStyle="bold"
        android:textSize="@dimen/sp_16" />

</LinearLayout>
