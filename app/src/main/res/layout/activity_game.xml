<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root">

    <LinearLayout
        android:id="@+id/gameTopBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="18dp"
        android:background="@drawable/bg_topbar"
        android:elevation="6dp">

        <Button
            android:id="@+id/gameBackButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/bg_channel"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:contentDescription="Kembali" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:text="🎮 Tebak Kata"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gameScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_channel"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Skor: 0"
            android:textColor="@color/game_accent_light"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:id="@+id/gameCategoryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_game"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="KATEGORI: TV"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/gameWordBlanksText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="_ _ _ _ _"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/gameFeedbackText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/live_dot"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/gameAnswerInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:hint="Ketik jawaban kamu..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textCursorDrawable="@null"
            android:textSize="16sp"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/gameSkipButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_outline"
                android:textColor="@color/text_primary"
                android:text="Lewati"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/gameSubmitButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_game"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:text="Jawab"
                android:textAllCaps="false"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
