<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol kecil bulat buat "⋯" pemicu filter (ganti card gede yang
     selalu nongol). Sengaja kecil & bulat biar kesannya cuma ikon, bukan
     ajakan buat diperhatikan terus-terusan. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brand_blue_glow">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/surface_stroke" />
        </shape>
    </item>
</ripple>
