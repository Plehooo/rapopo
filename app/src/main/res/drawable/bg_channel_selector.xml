<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Channel yang sedang diputar: border merah accent + gradient lebih terang -->
    <item android:state_selected="true">
        <ripple android:color="@color/accent_glow">
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/accent_soft"
                        android:endColor="@color/surface_elevated"
                        android:type="linear" />
                    <corners android:radius="18dp" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                </shape>
            </item>
        </ripple>
    </item>

    <!-- Channel biasa -->
    <item>
        <ripple android:color="@color/accent_glow">
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/surface_elevated"
                        android:endColor="@color/surface"
                        android:type="linear" />
                    <corners android:radius="18dp" />
                    <stroke android:width="1dp" android:color="@color/surface_stroke" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
