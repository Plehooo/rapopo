<?xml version="1.0" encoding="utf-8"?>
<!-- Frame logo versi "premium": ring tipis biru di luar (kesan glow),
     lalu kotak gradasi gelap dengan garis tepi biru di dalam. Menggantikan
     bg_channel polos yang sebelumnya dipakai buat bingkai logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
            <stroke
                android:width="5dp"
                android:color="@color/brand_blue_glow" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/surface_elevated"
                android:endColor="@color/surface"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/brand_blue" />
        </shape>
    </item>
</layer-list>
