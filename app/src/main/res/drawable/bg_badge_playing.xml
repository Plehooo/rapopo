<?xml version="1.0" encoding="utf-8"?>
<!-- Badge "SEDANG DIPUTAR": pill biru gradasi (bukan kotak pipih merah kayak
     sebelumnya), biar kebaca sebagai status khusus milik app, bukan tombol. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/brand_blue_light"
        android:centerColor="@color/brand_blue"
        android:endColor="@color/brand_blue_dark"
        android:type="linear" />
    <corners android:radius="20dp" />
</shape>
