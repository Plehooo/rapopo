<?xml version="1.0" encoding="utf-8"?>
<!-- Dasar gradasi lama tetap dipakai, ditambah "spotlight" biru lembut
     di pojok kanan atas — ciri khas premium yang halus, bukan norak. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/bg_root_soft"
                android:endColor="@color/bg_root"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="end|top"
        android:top="-70dp"
        android:end="-50dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:centerColor="@color/brand_blue_glow"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
