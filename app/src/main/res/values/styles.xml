<resources>
    <!--
        Global visual language:
        - vibrant purple/blue controls instead of stock grey AppCompat widgets
        - dark rounded dialogs so every AlertDialog matches the app canvas
        - inputs inherit the same surface language
        Explicit backgrounds in activity_main.xml remain untouched because
        per-view attributes override these defaults.
    -->
    <style name="Theme.BITTV" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/game_accent_light</item>
        <item name="colorAccent">@color/game_accent_light</item>
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/brand_blue_dark</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/game_accent_light</item>
        <item name="colorControlHighlight">@color/game_accent_glow</item>
        <item name="buttonStyle">@style/Widget.BITTV.Button</item>
        <item name="editTextStyle">@style/Widget.BITTV.EditText</item>
        <item name="alertDialogTheme">@style/Theme.BITTV.Dialog</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/bg_root</item>
    </style>

    <style name="Widget.BITTV.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_game</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.BITTV.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Widget.BITTV.DialogButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_dialog_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/game_accent_light</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Theme.BITTV.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.20</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">94%</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/game_accent_light</item>
        <item name="android:colorAccent">@color/game_accent_light</item>
        <item name="buttonStyle">@style/Widget.BITTV.DialogButton</item>
        <item name="editTextStyle">@style/Widget.BITTV.EditText</item>
    </style>

    <style name="Theme.BITTV.Splash" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
