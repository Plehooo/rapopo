<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palet "biru laut" — navy tegas & jenuh (bukan nyaris-hitam kayak
         sebelumnya), dengan gradasi elevation yang tetap kerasa biru di
         setiap lapisannya, bukan abu-abu gelap. -->
    <color name="bg_root">#071E36</color>
    <color name="bg_root_soft">#0D2C4C</color>
    <color name="surface">#123E64</color>
    <color name="surface_elevated">#1A527E</color>
    <color name="surface_stroke">#2E7CA6</color>
    <color name="divider">#143050</color>

    <!-- aksen utama: merah-oranye ala tombol "LIVE TV" — tetap dipertahankan
         khusus buat penanda LIVE (konvensi universal), gak diubah biar makna
         warnanya tetap konsisten -->
    <color name="accent">#FF2E52</color>
    <color name="accent_light">#FF8A6E</color>
    <color name="accent_dark">#B0193C</color>
    <color name="accent_soft">#3A2033</color>
    <color name="accent_glow">#40FF2E52</color>

    <!-- aksen kedua: biru-ungu buat tab Game -->
    <color name="game_accent">#7A5CFF</color>
    <color name="game_accent_light">#B9A2FF</color>
    <color name="game_accent_dark">#4A2FB0</color>
    <color name="game_accent_glow">#407A5CFF</color>

    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#9FC4E3</color>
    <color name="text_tertiary">#5C84A8</color>

    <color name="live_dot">#00F08A</color>
    <color name="live_dot_glow">#4000F08A</color>

    <!-- warna bintang favorite, biar beda dan gampang dikenali dari aksen lain -->
    <color name="favorite_gold">#FFCB4D</color>

    <!-- Identitas "biru laut" milik app sendiri: aksen teal terang, dipakai
         buat ring logo, border channel yang lagi diputar, badge
         "SEDANG DIPUTAR", dan warna notifikasi. Sengaja dibikin lebih
         jenuh/vivid dari sebelumnya (dulu indigo pudar #2F6BFF) biar kerasa
         "laut" beneran, bukan sekadar biru generik. Dipisah dari "accent"
         (merah, khusus LIVE) dan "game_accent" (ungu, khusus tab Game). -->
    <color name="brand_blue">#00C2D1</color>
    <color name="brand_blue_light">#6FF0FA</color>
    <color name="brand_blue_dark">#007A8A</color>
    <color name="brand_blue_soft">#0E3B49</color>
    <color name="brand_blue_glow">#4D00C2D1</color>
</resources>
