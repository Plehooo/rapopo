<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dulu nyaris hitam polos (#08090C). Sekarang dikasih tint biru gelap
         biar kerasa "hidup", bukan flat hitam — tetep gelap/nyaman buat nonton,
         tapi ada warna. -->
    <color name="bg_root">#0A0F1E</color>
    <color name="bg_root_soft">#0F1830</color>
    <color name="surface">#16213E</color>
    <color name="surface_elevated">#1D2B4F</color>
    <color name="surface_stroke">#2D3F68</color>
    <color name="divider">#1B2740</color>

    <!-- aksen utama: merah-oranye ala tombol "LIVE TV", dibikin sedikit lebih
         jenuh/vivid dari sebelumnya biar lebih nendang di atas latar biru gelap -->
    <color name="accent">#FF2E52</color>
    <color name="accent_light">#FF8A6E</color>
    <color name="accent_dark">#B0193C</color>
    <color name="accent_soft">#3A2033</color>
    <color name="accent_glow">#40FF2E52</color>

    <!-- aksen kedua: biru-ungu buat tab Game, dinaikkan sedikit saturasinya -->
    <color name="game_accent">#7A5CFF</color>
    <color name="game_accent_light">#B9A2FF</color>
    <color name="game_accent_dark">#4A2FB0</color>
    <color name="game_accent_glow">#407A5CFF</color>

    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#A7B3D6</color>
    <color name="text_tertiary">#5F6C93</color>

    <color name="live_dot">#00F08A</color>
    <color name="live_dot_glow">#4000F08A</color>

    <!-- warna bintang favorite, biar beda dan gampang dikenali dari aksen lain -->
    <color name="favorite_gold">#FFCB4D</color>

    <!-- Identitas "biru premium" milik app sendiri: dipakai buat ring logo,
         border channel yang lagi diputar, badge "SEDANG DIPUTAR", dan warna
         notifikasi. Dipisah dari "accent" (merah, khusus penanda LIVE) dan
         "game_accent" (ungu, khusus tab Game) biar tiap warna punya makna
         sendiri-sendiri, bukan asal ganti-ganti warna. -->
    <color name="brand_blue">#2F6BFF</color>
    <color name="brand_blue_light">#7AA6FF</color>
    <color name="brand_blue_dark">#123A9E</color>
    <color name="brand_blue_soft">#16224A</color>
    <color name="brand_blue_glow">#4D2F6BFF</color>
</resources>
