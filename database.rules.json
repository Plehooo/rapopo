{
  "rules": {
    "viewerPresence": {
      ".read": "auth != null",
      "$channelId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName','inviteCode']) && newData.child('displayName').isString() && newData.child('displayName').val().length >= 2 && newData.child('displayName').val().length <= 24 && newData.child('inviteCode').isString() && newData.child('inviteCode').val().matches(/^[A-Z0-9]{6,8}$/)"
      }
    },
    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid",
        ".validate": "newData.isString()"
      }
    },
    "friendRequests": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$fromUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid)",
          ".validate": "newData.hasChildren(['fromUid','createdAt']) && newData.child('fromUid').val() === $fromUid"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)",
          ".validate": "newData.hasChildren(['displayName','addedAt'])"
        }
      }
    },
    "virtualMarket": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('ownerUid').val() === auth.uid && newData.child('players').hasChild(auth.uid)",
        ".validate": "newData.hasChildren(['game','status','board','turn','players']) && newData.child('game').val() === 'ttt' && newData.child('status').val() === 'waiting' && newData.child('board').val() === '---------' && newData.child('turn').val() === auth.uid && newData.child('players').childrenCount <= 2",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('name').val() === newData.child('name').val())",
            ".validate": "newData.hasChildren(['name','ready']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 24 && newData.child('ready').isBoolean() && newData.parent().childrenCount <= 2"
          }
        }
      }
    },
    "raidRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('ownerUid').val() === auth.uid && newData.child('game').val() === 'raid' && newData.child('players').hasChild(auth.uid) && newData.child('players').childrenCount <= 4",
        ".validate": "newData.hasChildren(['game','ownerUid','status','round','bossEnergy','players']) && newData.child('game').val() === 'raid' && newData.child('status').val() === 'waiting' && newData.child('round').isNumber() && newData.child('bossEnergy').isNumber() && newData.child('players').childrenCount <= 4",
        "players": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid && data.exists() && newData.hasChildren(['name','ready']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('ready').isBoolean()"
          }
        },
        "actions": {
          ".write": "false"
        },
        "scores": {
          ".write": "false"
        },
        "status": {
          ".write": "false"
        },
        "bossEnergy": {
          ".write": "false"
        },
        "round": {
          ".write": "false"
        }
      }
    }
  }
}
